{
  "name": "ai-employee-factory",
  "version": "0.1.0",
  "description": "本地 AI 员工创建、隔离与生命周期管理 CLI/Web 控制台",
  "type": "module",
  "bin": {
    "agentctl": "dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.json && tsc -p tsconfig.web.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run build && npm test && npm run lint"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@inquirer/prompts": "^7.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fastify": "^5.11.0",
    "fs-extra": "^11.3.0",
    "lucide-react": "^0.468.0",
    "ora": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "tar": "^7.4.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.32.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
